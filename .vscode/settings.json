{
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "checkpoints": true,
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/checkpoints/**": true,
  },
  "python.analysis.exclude": [
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/checkpoints",
  ],
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/checkpoints": true,
  },
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "C:\\Users\\Dylan\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
      "env": {
        "SOURCE_DATE_EPOCH": "1785368588",
        "FORCE_SOURCE_DATE": "1"
      },
      "args": [
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-synctex=1",
        "%DOC%"
